# Copy this file to .env and fill in your real values
# NEVER commit the real .env file to GitHub — add it to .gitignore

# Role D: Groq API key from console.groq.com (free, no card required)
GROQ_API_KEY=your_groq_api_key_here

# Role C: Wallet private key for the Ethereum Sepolia testnet
# This should be a NEW wallet created just for this hackathon —
# never reuse a real wallet's private key.
TESTNET_PRIVATE_KEY=your_testnet_wallet_private_key_here

# Role C: Sepolia RPC URL (free public endpoint)
TESTNET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

PORT=3000
